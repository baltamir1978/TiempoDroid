<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- «Permitir siempre»: el widget de la ubicación actual, con la app cerrada -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- La sesión de Netatmo de Calefacción, compartida (net/Netatmo.kt, SharedSession) -->
    <queries>
        <package android:name="es.altamirano.calefaccion" />
        <provider android:authorities="es.altamirano.calefaccion.netatmo" />
    </queries>

    <application
        android:name=".TiempoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tiempo"
        android:localeConfig="@xml/locales_config">

        <activity android:name=".ui.MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Los widgets abren su pestaña: tiempo://aemet, netatmo, cosmos, tides -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tiempo" />
            </intent-filter>
            <!-- La vuelta del inicio de sesión de Netatmo (hay que darla de alta en dev.netatmo.com) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tiempo-netatmo" android:host="oauth-callback" />
            </intent-filter>
        </activity>

        <activity android:name=".widget.WidgetConfigActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>

        <receiver android:name=".widget.LocationReceiver" android:exported="false" />
        <receiver android:name=".widget.WeatherWidgetReceiver" android:exported="true" android:label="@string/widget_weather_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_weather" />
        </receiver>
        <receiver android:name=".widget.NetatmoWidgetReceiver" android:exported="true" android:label="Netatmo">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_netatmo" />
        </receiver>
        <receiver android:name=".widget.SunMoonWidgetReceiver" android:exported="true" android:label="@string/widget_sunmoon_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sunmoon" />
        </receiver>
        <receiver android:name=".widget.TidesWidgetReceiver" android:exported="true" android:label="@string/widget_tides_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tides" />
        </receiver>
    </application>
</manifest>
